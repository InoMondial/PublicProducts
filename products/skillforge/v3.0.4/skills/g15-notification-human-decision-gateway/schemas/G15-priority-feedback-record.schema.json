{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "G15 Priority Feedback Record v3.0.0",
  "type": "object",
  "required": ["RuleKey","TargetPriority","Direction","UpdatedAt","Active"],
  "properties": {
    "RuleKey": {"type":"string","minLength":1},
    "NotificationClass": {"type":["string","null"]},
    "TargetPriority": {"type":"string","enum":["HIGH","MED","LOW"]},
    "Direction": {"type":"string","enum":["ABSOLUTE","HIGHER","LOWER"]},
    "SourceSkill": {"type":["string","null"]},
    "EventType": {"type":["string","null"]},
    "UpdatedBy": {"type":["string","null"]},
    "UpdatedAt": {"type":"string"},
    "SourceMessageRef": {"type":["string","null"]},
    "Comment": {"type":["string","null"]},
    "Active": {"type":"boolean"}
  },
  "additionalProperties": false
}
